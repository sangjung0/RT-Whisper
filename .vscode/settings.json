{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "python":"zsh -c 'set -a && source $workspaceRoot/.env && exec $workspaceRoot/.venv/bin/python -u $fullFileName'"
    },
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "indent",
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "python.envFile": "${workspaceFolder}/.env",
    "python.analysis.exclude": [
        "**/.git",
        "**/.data",
        "**/.vscode",
        "**/__pycache__",
        "**/output",
        "**/logs",
        ".datasets",
        ".storage",
    ],
    "search.exclude": {
        "**/.git": true,
        "**/.data": true,
        "**/.vscode": true,
        "**/__pycache__": true,
        "**/output": true,
        "**/logs": true,
        ".datasets": true,
        ".storage": true,
        "**/.venv/**": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.data/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        ".datasets/**": true,
        ".storage/**": true,
    },
    // Editor
    "editor.fontFamily": "JetBrains Mono, D2Coding",
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.letterSpacing": 0,
    "editor.detectIndentation": false,
    "editor.trimAutoWhitespace": true,
    "terminal.integrated.fontFamily": "JetBrains Mono, D2Coding",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // Formatter
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.tabSize": 4
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": false,
    },
    "cSpell.words": [
        "archiver",
        "cuda",
        "ESIC",
        "figsize",
        "flac",
        "fout",
        "huggingface",
        "iinfo",
        "importances",
        "Libri",
        "ndarray",
        "nhead",
        "orto",
        "PUNCT",
        "pysbd",
        "saveloaders",
        "sclite",
        "silero",
        "trns",
        "wavfile"
    ]
}
